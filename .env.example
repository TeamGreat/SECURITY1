# ============================================================================
# ABA Security Oracle - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys and settings
# ============================================================================

# ======================== OPENWEATHER API ===================================
# Get your free API key from: https://openweathermap.org/api
# Free tier: 60 calls/minute, 1,000 calls/day
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ======================== TWITTER/X API ====================================
# Get your Bearer Token from: https://developer.twitter.com/
# Requires elevated access for v2 API
# This is for monitoring security-related tweets in real-time
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ======================== NEWS API ==========================================
# Get your API key from: https://newsapi.org/
# Free tier: 100 requests/day
# Used for fetching security-related news in Abia State region
NEWSAPI_KEY=your_newsapi_key_here

# ======================== GOOGLE/SERPAPI SEARCH =============================
# Get your API key from: https://serpapi.com/ (alternative: Google Custom Search)
# Used for web search on security incidents and patterns
SERPAPI_KEY=your_serpapi_key_here

# ======================== ANTHROPIC CLAUDE (Optional) =======================
# Get your API key from: https://console.anthropic.com/
# Required only if using Claude for advanced analysis
# If not set, system will use rule-based responses
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ======================== DATABASE CONFIGURATION =============================
# PostgreSQL connection string (optional - for production data storage)
# Format: postgresql://user:password@localhost:5432/database_name
DATABASE_URL=

# Redis connection (optional - for caching and sessions)
# Format: redis://localhost:6379/0
REDIS_URL=

# ======================== APPLICATION SETTINGS ===============================
# Enable/disable mock data usage (for testing without API keys)
# Set to 'false' to use real API calls
USE_MOCK_DATA=true

# Application environment: 'development', 'staging', or 'production'
APP_ENV=development

# Streamlit app configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLECORS=false

# FastAPI server port (if running backend separately)
API_SERVER_PORT=8000
API_SERVER_HOST=127.0.0.1

# ======================== LOCATION SETTINGS ==================================
# Default analysis location (Aba, Abia State, Nigeria)
DEFAULT_LATITUDE=5.1065
DEFAULT_LONGITUDE=7.3667
DEFAULT_LOCATION_NAME=Aba, Abia State, Nigeria

# Coverage radius for police station analysis (km)
POLICE_COVERAGE_RADIUS_KM=2.0

# Clustering parameters for hotspot detection
HOTSPOT_CLUSTERING_EPS_KM=0.5
HOTSPOT_MIN_SAMPLES=3

# ======================== SECURITY SETTINGS ==================================
# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# API rate limiting (requests per minute)
API_RATE_LIMIT_PER_MINUTE=60
TWITTER_RATE_LIMIT_PER_MINUTE=15
NEWS_RATE_LIMIT_PER_MINUTE=100

# ======================== DATA PATHS =========================================
# Paths to data files (relative to project root)
INCIDENTS_DATA_PATH=data/incidents.csv
POLICE_STATIONS_PATH=data/police.csv
ROAD_NETWORK_PATH=data/aba_roads.graphml
POI_DATA_PATH=data/aba_pois.geojson

# ======================== LOGGING & DEBUG ===================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (verbose output)
DEBUG=false

# ======================== SECURITY ALERTS ==================================
# Email settings for alert notifications (optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# Webhook for incident notifications (optional)
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
INCIDENT_WEBHOOK_URL=

# ======================== ADVANCED FEATURES ================================
# Enable MCP (Model Context Protocol) tools
ENABLE_MCP_TOOLS=true

# Enable real-time incident monitoring
ENABLE_REALTIME_MONITORING=false

# Cache TTL (Time To Live) in seconds
WEATHER_CACHE_TTL=600
NEWS_CACHE_TTL=1800
SOCIAL_CACHE_TTL=300
SEARCH_CACHE_TTL=3600

# ======================== NOTES ============================================
# 1. NEVER commit the .env file with real API keys to version control
# 2. Keep .env.example with placeholder values for documentation
# 3. Add .env to .gitignore to prevent accidental commits
# 4. For production, use environment variables set in deployment platform
# 5. Rotate API keys periodically for security
